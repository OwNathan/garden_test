SITE_NAME_HEADER=Archive
SITE_MAIN_LANGUAGE=en
SITE_BASE_URL=
SHOW_CREATED_TIMESTAMP=false
TIMESTAMP_FORMAT=MMM dd, yyyy h:mm a
SHOW_UPDATED_TIMESTAMP=false
NOTE_ICON_DEFAULT=
NOTE_ICON_TITLE=false
NOTE_ICON_FILETREE=false
NOTE_ICON_INTERNAL_LINKS=false
NOTE_ICON_BACK_LINKS=false
STYLE_SETTINGS_CSS=body.css-settings-manager { --callout-default: var(--color-blue-rgb); --custom-color-space: srgb; } body.theme-light.css-settings-manager { } body.theme-dark.css-settings-manager { --custom-color-base-00: #0D0C11; --custom-color-base-100: #E3E7EC; }
STYLE_SETTINGS_BODY_CLASSES=theme-dark mod-windows is-frameless is-hidden-frameless obsidian-app styled-scrollbars show-inline-title show-ribbon show-view-header additional-editor-css image-captions-enabled css-settings-manager fas-hue is-focused fas-adaptive-accent fas-silver-light fas-custom-dark fas-accessibility fas-sans-serif fas-callout-cite-alt fas-callout-infobox fas-headings-rainbow fas-hr
USE_FULL_RESOLUTION_IMAGES=true
THEME=https://raw.githubusercontent.com/ElsaTam/obsidian-fancy-a-story/HEAD/theme.css
BASE_THEME=dark
dgHomeLink=true
dgPassFrontmatter=false
dgShowBacklinks=true
dgShowLocalGraph=false
dgShowInlineTitle=false
dgShowFileTree=true
dgEnableSearch=true
dgShowToc=true
dgLinkPreview=false
dgShowTags=false